# Copy to .env and fill in credentials. .env is gitignored.

# Required to use the real LLM path in smoke tests and the app.
RECONCILIATION_LLM_ENABLED=true
RECONCILIATION_LLM_PROVIDER=openrouter
RECONCILIATION_LLM_MODEL=openai/gpt-4o-mini
RECONCILIATION_LLM_TIMEOUT_SECONDS=45

# OpenRouter (default provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Reconciliation Investigator
OPENROUTER_APP_REFERER=

# Direct OpenAI — only needed if RECONCILIATION_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
